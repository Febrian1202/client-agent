# Application
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/client_agent

# Redis (Queue & Session)
REDIS_URL=redis://localhost:6380

# Single-User Authentication (ADR-011)
AUTH_USERNAME=admin
# Generate hash with Bun.password.hash("your-secure-password")
# Note: Escape dollar signs with \$ in .env for Bun: '\$argon2id\$v=...'
AUTH_PASSWORD_HASH='\$argon2id\$v=19\$m=65536,t=2,p=1\$placeholder\$placeholder'
AUTH_SECRET=replace_with_a_secure_random_string_for_cookie_signing

# Browser Automation (Playwright)
# Prefer an ABSOLUTE path: scripts run with repo-root as cwd while the worker
# runs with its package dir as cwd, so only an absolute path guarantees both
# share ONE profile directory (single login, single session).
BROWSER_PROFILE_PATH=./browser-profile

# Gmail & Google Cloud Pub/Sub (Phase 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/integrations/gmail/callback
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=

# Discord Bot (Phase 1)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

# AI Provider (Phase 4 - OpenAI-Compatible / 9router)
AI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_MODEL=gpt-4o
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
