{
  "name": "client-agent-root",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --filter=@client-agent/api dev",
    "dev:web": "bun --filter=@client-agent/web dev",
    "dev:worker": "bun --filter=@client-agent/worker dev",
    "dev": "bun --filter='*' dev",
    "build": "bun --filter='*' run build",
    "typecheck": "tsc --noEmit && bun run --filter=@client-agent/web check",
    "browser:auth": "bun run scripts/setup-browser-session.ts",
    "browser:smoke": "bun run packages/vgen/scripts/smoke-vgen-read.ts",
    "generate:password": "bun run scripts/generate-password.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "drizzle-orm": "^0.39.3",
    "elysia": "^1.2.25"
  }
}
